# --- Dependencias (NUNCA subir) ---
node_modules/

# --- Variables de entorno y secretos (NUNCA subir) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Archivos de registro (logs) ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Artefactos de compilación y cobertura ---
dist/
build/
coverage/
*.tsbuildinfo

# --- Archivos de sistema operativo ---
.DS_Store
Thumbs.db

# --- Archivos de editores de código (opcional) ---
# Si quieres compartir la configuración del equipo, puedes ignorar solo las carpetas personales.
.idea/
.vscode/
# Pero si quieres compartir la configuración de VSCode, descomenta la siguiente línea:
# !.vscode/settings.json

# --- Archivos temporales ---
*.tmp
*.temp
*.bak