# deploy/ms-reservas.service — unidad de systemd para ms-reservas (servidor2)
# Referencia para el día del examen: NO se instala antes de la evaluación.
# Supone el repositorio clonado en /srv/m3examen/app (ajustar si se usa otra ruta).
# Instalar: sudo cp deploy/ms-reservas.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now ms-reservas
[Unit]
Description=Microservicio reservas - Evaluacion Modulo 3
After=network.target

[Service]
User=nodeapps
Group=nodeapps
# src/server.js carga el .env con dotenv desde este directorio
WorkingDirectory=/srv/m3examen/app/ms-reservas
ExecStart=/usr/bin/node src/server.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
