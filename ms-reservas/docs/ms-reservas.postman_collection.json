    {
      "name": "07 Crear reserva → 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/reservas",
          "host": [
            "{{base}}"
          ],
          "path": [
            "reservas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"{{codigo_nuevo}}\",\n  \"huesped\": \"Luis Pérez\",\n  \"fecha_entrada\": \"2026-12-15\",\n  \"fecha_salida\": \"2026-12-18\",\n  \"personas\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"codigo_nuevo\", \"RES-T\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.collectionVariables.set(\"id_nuevo\", r.id);"
            ]
          }
        }
      ]
    },
