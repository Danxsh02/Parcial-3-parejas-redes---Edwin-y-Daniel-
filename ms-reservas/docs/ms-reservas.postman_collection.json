{
  "info": {
    "name": "ms-reservas - Evaluación M3 (preparación)",
    "description": "Login en ms-usuarios y casos de cada código de ms-reservas. Ejecutar en orden con el Runner. Variables de la colección: base, base_usuarios, email, password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:3011"
    },
    {
      "key": "base_usuarios",
      "value": "http://127.0.0.1:3001"
    },
    {
      "key": "email",
      "value": "admin@empresa.com"
    },
    {
      "key": "password",
      "value": "Admin2026*"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "codigo_nuevo",
      "value": ""
    },
    {
      "key": "id_nuevo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Login administrador (ms-usuarios) → 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_usuarios}}/usuarios/login",
          "host": [
            "{{base_usuarios}}"
          ],
          "path": [
            "usuarios",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Trae token\", () => pm.expect(r.token).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"token\", r.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Listar sin token → 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/reservas",
          "host": [
            "{{base}}"
          ],
          "path": [
            "reservas"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar reservas → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/reservas",
          "host": [
            "{{base}}"
          ],
          "path": [
            "reservas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Es un arreglo con al menos 3\", () => pm.expect(pm.response.json()).to.be.an(\"array\").with.length.at.least(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Filtro ?huesped= → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/reservas?huesped=Carlos Ramirez",
          "host": [
            "{{base}}"
          ],
          "path": [
            "reservas"
          ],
          "query": [
            {
              "key": "huesped",
              "value": "Carlos Ramirez"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Solo reservas de Carlos Ramirez\", () => { pm.expect(r.length).to.be.above(0); r.forEach(x => pm.expect(x.huesped).to.eql(\"Carlos Ramirez\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Obtener por id → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/reservas/1",
          "host": [
