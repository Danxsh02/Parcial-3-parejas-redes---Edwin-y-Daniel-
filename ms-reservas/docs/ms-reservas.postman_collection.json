          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Es la reserva 1\", () => pm.expect(pm.response.json().id).to.eql(1));"
            ]
          }
        }
      ]
    },
