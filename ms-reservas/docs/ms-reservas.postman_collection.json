    {
      "name": "05 POST crear -> 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('codigoNuevo', 'RES-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('trae id y codigo', () => { pm.expect(j.id).to.exist; pm.expect(j.codigo).to.eql(pm.collectionVariables.get('codigoNuevo')); });",
              "pm.collectionVariables.set('idCreado', j.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": {
          "raw": "{{reservasUrl}}"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"{{codigoNuevo}}\",\n  \"huesped\": \"Huesped Prueba\",\n  \"fecha_entrada\": \"2027-03-01\",\n  \"fecha_salida\": \"2027-03-04\",\n  \"personas\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
