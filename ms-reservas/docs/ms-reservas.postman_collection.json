  "item": [
    {
      "name": "01 Login administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 login admin', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('trae token', () => pm.expect(j.token).to.be.a('string'));",
              "pm.collectionVariables.set('tokenAdmin', j.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{loginUrl}}"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
